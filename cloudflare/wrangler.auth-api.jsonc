{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "exclusive-auth-api",
  "main": "src/workers/auth-api.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 0.25 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "exclusive-membership",
    "database_id": "fc38b1d0-2e77-42a5-ac5c-72603fcb95ab",
    "migrations_dir": "migrations"
  }],
  "services": [{
    "binding": "IDENTITY_PROJECTION",
    "service": "exclusive-identity-projection"
  }],
  "ratelimits": [{
    "name": "AUTH_RATE_LIMITER",
    "namespace_id": "64000301",
    "simple": { "limit": 30, "period": 60 }
  }],
  "vars": {
    "SITE_ORIGINS": "https://exclusive.jason-shadow.com",
    "AUTH_PASSWORD_PEPPER_VERSION": "v2",
    "AUTH_PASSWORD_PEPPER_PREVIOUS_VERSION": "v1",
    "AUTH_ENCRYPTION_KEY_VERSION": "v2",
    "AUTH_ENCRYPTION_KEY_PREVIOUS_VERSION": "v1",
    "SESSION_DAYS": "30",
    "DEVICE_LIMIT": "3"
  }
}
