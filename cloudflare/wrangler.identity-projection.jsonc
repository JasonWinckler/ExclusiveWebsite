{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "exclusive-identity-projection",
  "main": "src/workers/identity-projection.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "directory": "../linktree/uploads",
    "binding": "EMAIL_ASSETS"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 0.1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "vars": {
    "APPWRITE_ENDPOINT": "https://auth-exclusive.jason-shadow.com/v1",
    "APPWRITE_PROJECT_ID": "6a64cbeb0009826c9efc",
    "GRAPH_SENDER_MAILBOX": "info@exclusive.jason-shadow.com",
    "MAX_UPSTREAM_JSON_BYTES": "65536"
  },
  "env": {
    "preview": {
      "name": "exclusive-identity-projection-preview",
      "vars": {
        "APPWRITE_ENDPOINT": "https://auth-exclusive.jason-shadow.com/v1",
        "APPWRITE_PROJECT_ID": "6a64cbeb0009826c9efc",
        "GRAPH_SENDER_MAILBOX": "info@exclusive.jason-shadow.com",
        "MAX_UPSTREAM_JSON_BYTES": "65536"
      }
    }
  }
}
