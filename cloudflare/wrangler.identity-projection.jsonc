{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "exclusive-identity-projection",
  "main": "src/workers/identity-projection.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 0.1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "vars": {
    "APPWRITE_ENDPOINT": "https://fra.cloud.appwrite.io/v1",
    "APPWRITE_PROJECT_ID": "6a64cbeb0009826c9efc",
    "MAX_UPSTREAM_JSON_BYTES": "65536"
  },
  "env": {
    "preview": {
      "name": "exclusive-identity-projection-preview",
      "vars": {
        "APPWRITE_ENDPOINT": "https://fra.cloud.appwrite.io/v1",
        "APPWRITE_PROJECT_ID": "6a64cbeb0009826c9efc",
        "MAX_UPSTREAM_JSON_BYTES": "65536"
      }
    }
  }
}
